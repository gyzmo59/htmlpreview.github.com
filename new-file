<!DOCTYPE html>
<html lang="fr"><head>    <meta charset="UTF-8">    <meta name="viewport" content="width=device-width, initial-scale=1.0">    <title>Convertisseur Coordonnées</title>    <style>        * { margin: 0; padding: 0; box-sizing: border-box; }        body {             font-family: -apple-system, BlinkMacSystemFont, sans-serif;            background: linear-gradient(135deg, #667eea, #764ba2);            min-height: 100vh;            padding: 20px;        }        .app {            max-width: 500px;            margin: 0 auto;            background: white;            border-radius: 20px;            overflow: hidden;            box-shadow: 0 20px 40px rgba(0,0,0,0.2);        }        .header {            background: linear-gradient(135deg, #2c3e50, #34495e);            color: white;            padding: 25px;            text-align: center;        }        .header h1 {            font-size: 24px;            margin-bottom: 5px;        }        .content {            padding: 25px;        }        .input-group {            margin-bottom: 20px;        }        label {            display: block;            margin-bottom: 8px;            font-weight: 600;            color: #2c3e50;        }        input {            width: 100%;            padding: 15px;            border: 2px solid #e1e8ed;            border-radius: 10px;            font-size: 16px;            background: #f8f9fa;        }        .convert-btn {            width: 100%;            padding: 18px;            background: linear-gradient(135deg, #2ecc71, #27ae60);            color: white;            border: none;            border-radius: 12px;            font-size: 18px;            font-weight: bold;            margin: 15px 0;            cursor: pointer;            box-shadow: 0 4px 0 #219653;        }        .convert-btn:active {            transform: translateY(2px);            box-shadow: 0 2px 0 #219653;        }        .result {            background: #e8f5e8;            padding: 20px;            border-radius: 12px;            margin: 20px 0;            border-left: 5px solid #27ae60;            display: none;        }        .info {            background: #f8f9fa;            padding: 15px;            border-radius: 10px;            font-size: 14px;            border: 1px solid #e9ecef;        }    </style></head><body>    <div class="app">        <div class="header">            <h1>📐 Convertisseur Coordonnées</h1>            <p>Application Mobile Professionnelle</p>        </div>                <div class="content">            <div class="input-group">                <label>📍 Coordonnée X technique</label>                <input type="number" id="xInput" placeholder="Ex: 234102">            </div>                        <div class="input-group">                <label>📍 Coordonnée Y technique</label>                <input type="number" id="yInput" placeholder="Ex: 6171">            </div>                        <button class="convert-btn" onclick="convertir()">                🔄 CONVERTIR            </button>                        <div id="result" class="result"></div>                        <div class="info">                <strong>📋 Plages de référence :</strong><br>                • X: 14375 à 342858 → 68 à 380<br>                • Y: 5964 à 36477 → A à N<br><br>                <strong>🎯 Testez avec : X=234102, Y=6171</strong>            </div>        </div>    </div>    <script>        function convertirX(x) {            if (x < 14375) return [68, "HORS LIMITE"];            if (x > 342858) return [380, "HORS LIMITE"];                        // Intervalle spéciale 190-192            if (x >= 144778 && x <= 152655) {                const pos = 190 + ((x - 144778) / (152655 - 144778)) * 2;                return [Math.round(pos * 10) / 10, "SPÉCIAL 190-192"];            }                        const pos = 68 + ((x - 14375) / (342858 - 14375)) * 312;            return [Math.round(pos * 10) / 10, "OK"];        }        function convertirY(y) {            if (y < 5964) return ["A", "HORS LIMITE"];            if (y > 36477) return ["N", "HORS LIMITE"];                        const lettres = ['A','B','C','D','E','F','G','H','J','K','L','M','N'];            const intervalle = (36477 - 5964) / 12;            const index = Math.min(12, Math.max(0, Math.round((y - 5964) / intervalle)));            return [lettres[index], "OK"];        }        function convertir() {            const x = parseFloat(document.getElementById('xInput').value);            const y = parseFloat(document.getElementById('yInput').value);            const result = document.getElementById('result');                        if (isNaN(x) || isNaN(y)) {                result.innerHTML = "❌ Entrez des nombres valides";                result.style.display = 'block';                result.style.background = '#ffe6e6';                return;            }                        const [xPos, xStatut] = convertirX(x);            const [yPos, yStatut] = convertirY(y);                        let html = `<div style="text-align:center; color:#27ae60; font-weight:bold; margin-bottom:15px;">                ✅ CONVERSION RÉUSSIE            </div>`;                        if (xStatut === "SPÉCIAL 190-192") {                html += `<div style="background:#fff3cd; color:#856404; padding:10px; border-radius:8px; margin:10px 0; text-align:center;">                    ⚠️ Intervalle spéciale 190-192                </div>`;            }                        html += `                <div style="margin:10px 0;">                    <strong>Coordonnées techniques :</strong><br>                    X = <span style="color:#e74c3c; font-weight:bold">${x}</span><br>                    Y = <span style="color:#e74c3c; font-weight:bold">${y}</span>                </div>                <div style="margin:10px 0;">                    <strong>Position sur le plan :</strong><br>                    X = <span style="color:#2980b9; font-weight:bold; font-size:20px">${xPos}</span><br>                    Y = <span style="color:#2980b9; font-weight:bold; font-size:20px">${yPos}</span>                </div>                <div style="margin:10px 0;">                    <strong>Statut :</strong><br>                    X: ${xStatut}<br>                    Y: ${yStatut}                </div>            `;                        result.innerHTML = html;            result.style.display = 'block';            result.style.background = '#e8f5e8';        }        // Pré-remplir avec des valeurs de test        document.getElementById('xInput').value = '148716';        document.getElementById('yInput').value = '6171';    </script></body></html>